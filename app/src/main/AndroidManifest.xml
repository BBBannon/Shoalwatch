<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Downloads (Milestone 4) run as one WorkManager foreground worker of type dataSync, so Android 14+ needs the
        data-sync foreground-service permission, and the progress notice needs POST_NOTIFICATIONS (downloads still run
        without it). WAKE_LOCK, RECEIVE_BOOT_COMPLETED and FOREGROUND_SERVICE come from work-runtime's own manifest:
        WorkManager holds a wake lock while foreground work runs and reschedules after a reboot. Milestone 3's removal of
        WAKE_LOCK is gone for that reason; the player still sets no wake mode (Media3BoundaryTest bans setWakeMode).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        The app lock (Milestone 7) asks for the phone's own screen lock through the framework BiometricPrompt, which needs
        USE_BIOMETRIC (a normal permission, granted at install). Nothing about the person or the answer is kept.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        usesCleartextTraffic="true" is deliberate. Users may opt in to a plain-HTTP LAN server, per
        server, and the manifest cannot express per-user hosts. HTTPS stays the default: the
        CleartextGuard OkHttp interceptor (net/CleartextGuard) refuses http:// unless that server
        has the opt-in. No network_security_config is used, so user-installed CAs are not trusted.

        Library components removed below (S7, S10; checked on the merged release manifest by
        the verifyReleaseManifest Gradle task): the profile installer's exported receiver and its
        start-up initialiser, and the EmojiCompat initialiser, which can ask Google Play services
        for an emoji font (the app contacts nobody but the user's own servers).

        appCategory="game" (Milestone 9): Android Auto lets an app from outside Play run on the car screen only as a parked app in an
        allowed category, and games are the one it always allows (video needs a Google flag and a newer head unit). It changes nothing
        on the phone. There is no Car App Library service, the same as AAFin's working parked build (the reason is unproven).
    -->
    <application
        android:name=".ShoalwatchApp"
        android:allowBackup="false"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shoalwatch"
        android:usesCleartextTraffic="true">

        <!--
            Picture-in-picture (Milestone 7): entering and leaving the small window, turning the phone and resizing it change the
            window, not the activity, so playback is not interrupted; Compose redraws for these on its own. Dark mode, text size
            and language still recreate it.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The Android Auto parked app (Milestone 9; see "Android Auto (parked)" in docs/ARCHITECTURE.md). Android Auto lists an
            activity with CAR_LAUNCHER and runs it on the car screen only while parked. Exported for Android Auto with this one filter
            and nothing else; its own task, apart from the phone's. It reads nothing from its intent, shows nothing of a locked
            profile, and its window is never secure (Android Auto blanks a FLAG_SECURE window).
        -->
        <activity
            android:name=".ui.car.ParkedCarActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="app.shoalwatch.car"
            android:theme="@style/Theme.Shoalwatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Starts the process after a restart so waiting changes and downloads go on (BootReceiver: WorkManager's own
            reschedule receiver can be left switched off by a reboot). Not exported: only the system's broadcast reaches it.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lint cannot see this class (profileinstaller only arrives at run time, through other libraries); the removal is deliberate (S7). -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
            WorkManager: its foreground service runs the download worker as dataSync (without the type Android 14+
            refuses to start it); its diagnostics receiver (exported, DUMP-protected) is not needed. SystemJobService
            stays exported, protected by BIND_JOB_SERVICE, so only the system can bind it.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                tools:node="remove" />
            <!-- WorkManager starts on demand with the app's own worker factory (ShoalwatchApp is a Configuration.Provider). -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
