    <string name="http_title">This connection isn’t encrypted</string>
    <string name="http_body">On a network you don’t trust, such as public Wi-Fi, other people could read what you watch and capture your sign-in. On another network that happens to use the same address, a different device could pose as your server and capture your sign-in. Only continue if this server is on a network you trust, like your home Wi-Fi.</string>
    <string name="http_for_home">This warning is about your home address.</string>
    <string name="http_for_away">This warning is about your away address.</string>
