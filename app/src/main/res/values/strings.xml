    <string name="clientcert_title">This server needs a certificate from your phone</string>
    <string name="clientcert_body">A client certificate proves to your server that this phone is allowed to connect. Choose the one your server expects. If none is listed, install it on this phone first, or ask whoever runs the server.</string>
    <string name="clientcert_choose">Choose certificate</string>

    <string name="found_title">Server found</string>
    <string name="found_version">Jellyfin %1$s</string>
    <string name="found_home_note">This will be saved as your home address, used when you’re on your own Wi-Fi.</string>
