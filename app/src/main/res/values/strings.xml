    <!-- Add server -->
    <string name="add_title_first">Welcome to Shoalwatch</string>
    <string name="add_title">Add a server</string>
    <string name="add_intro">Enter the address of your Jellyfin server. It’s the one you’d type into a browser to watch.</string>
    <string name="add_address_label">Server address</string>
    <string name="add_address_example">For example jellyfin.example.org or 192.168.1.10:8096</string>
