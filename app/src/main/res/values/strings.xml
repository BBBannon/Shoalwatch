    <string name="http_scope">This applies to this server only.</string>
    <string name="http_use">Use anyway for this server</string>

    <string name="cert_title">This server uses its own security certificate</string>
    <string name="cert_body">Only trust this if it’s your own server. If someone else runs it, ask them to confirm this fingerprint. Not sure? Press Cancel.</string>
