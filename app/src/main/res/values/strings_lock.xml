    <string name="switch_pin_title">Switch to %1$s?</string>
    <string name="switch_pin_body">%1$s’s profile is protected. Enter its PIN.</string>
    <string name="switch_pin_confirm">Switch</string>
    <string name="profile_protected_cd">%1$s, protected</string>
    <string name="grownup_title">A grown-up’s PIN is needed</string>
    <string name="grownup_body">This setting changes things for everyone on this phone. Choose a protected profile and enter its PIN.</string>
