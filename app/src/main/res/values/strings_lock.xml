<?xml version="1.0" encoding="utf-8"?>
<!-- App lock and profile protection (Milestone 7). Every lock word lives here, not in strings.xml. -->
<resources>
    <!-- PIN (Task 2) -->
    <string name="pin_label">PIN</string>
    <plurals name="pin_wrong">
        <item quantity="one">That PIN isn’t right. 1 try left before a wait.</item>
        <item quantity="other">That PIN isn’t right. %1$d tries left before a wait.</item>
    </plurals>
    <!-- Wrong(0): the wait has already started with this wrong PIN (Task 5, controller decision). -->
    <string name="pin_wrong_last">That PIN isn’t right. Too many wrong PINs. Try again in %1$s.</string>
    <string name="pin_wait">Too many wrong PINs. Try again in %1$s.</string>
    <string name="pin_unreadable">This PIN can’t be checked on this phone any more. Use Forgot PIN.</string>
    <string name="pin_rules">Use 4 to 12 digits.</string>
    <!-- The try could not be saved (a full or damaged phone): nothing was checked. -->
    <string name="pin_not_saved">The PIN wasn’t checked because this phone couldn’t save the try. Your phone may be out of space. Free up some space and try again.</string>
    <plurals name="wait_minutes">
        <item quantity="one">1 minute</item>
        <item quantity="other">%1$s minutes</item>
    </plurals>
    <plurals name="wait_seconds">
        <item quantity="one">1 second</item>
        <item quantity="other">%1$s seconds</item>
    </plurals>
    <string name="wait_minutes_seconds">%1$s %2$s</string>

